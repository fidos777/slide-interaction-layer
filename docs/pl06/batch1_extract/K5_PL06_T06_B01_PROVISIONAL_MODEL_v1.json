 "prose_styled_as_heading": {
  "cls": "SOURCE_DERIVED",
  "count": 18,
  "rows": [
   {
    "row_id": "T06B01-ROW-006",
    "text": "Ia kemudian merangka langkah-langkah pencegahan, mitigasi (pengurangan), dan pemulihan untuk mengurus impak-impak terseb",
    "module_page": 295,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-007",
    "text": "EMP juga menetapkan prosedur pemantauan (monitoring), pelaporan (reporting), dan tindakan pembetulan (corrective actions",
    "module_page": 295,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-008",
    "text": "Tujuannya adalah untuk meminimumkan jejak ekologi projek dan memaksimumkan faedah alam sekitar.",
    "module_page": 295,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-025",
    "text": "Melibatkan langkah-langkah untuk mengawal hakisan tanah dan sedimen daripada memasuki sumber air (sungai, tasik, saliran",
    "module_page": 296,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-026",
    "text": "Pengurusan air sisa pembinaan (jika ada) dan pencegahan tumpahan bahan kimia atau minyak ke dalam sistem air.",
    "module_page": 296,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-027",
    "text": "Pemanfaatan sumber air secara cekap, terutamanya dalam sistem pengairan.",
    "module_page": 296,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-043",
    "text": "Mengurangkan pelepasan zarah habuk dari aktiviti pemotongan tanah, penggalian, atau pergerakan kenderaan.",
    "module_page": 297,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-044",
    "text": "Kawalan terhadap asap dan gas dari jentera berat atau pembakaran sisa.",
    "module_page": 297,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-045",
    "text": "Pengurusan bau dari bahan organik atau sisa.",
    "module_page": 297,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-061",
    "text": "Mengenal pasti sumber bunyi bising yang utama (jentera, pemotongan, pembinaan) dan mengambil langkah untuk meminimumkan ",
    "module_page": 298,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-062",
    "text": "Pematuhan kepada had bunyi yang ditetapkan oleh pihak berkuasa.",
    "module_page": 298,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-074",
    "text": "Kawalan getaran yang dihasilkan oleh aktiviti seperti pemancangan cerucuk, pemadatan tanah, atau penggunaan jentera bera",
    "module_page": 299,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-075",
    "text": "Penilaian potensi risiko kerosakan struktur atau gangguan kepada komuniti.",
    "module_page": 299,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-085",
    "text": "Mengurus bahan organik, tanah yang tercemar, atau sisa buangan yang boleh menghasilkan bau busuk.",
    "module_page": 300,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-086",
    "text": "Penyimpanan dan pelupusan bahan dengan cara yang betul.",
    "module_page": 300,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-096",
    "text": "Mengenal pasti spesies tumbuhan (flora) dan haiwan (fauna) yang penting atau dilindungi di tapak projek.",
    "module_page": 301,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-097",
    "text": "Melaksanakan langkah-langkah untuk mengelakkan kemusnahan habitat, gangguan kepada hidupan liar, dan kehilangan biodiver",
    "module_page": 301,
    "style": "Heading3"
   },
   {
    "row_id": "T06B01-ROW-098",
    "text": "Mempelbagaikan spesies tumbuhan asli dalam reka bentuk landskap untuk menyokong ekosistem tempatan.",
    "module_page": 301,
    "style": "Heading3"
   }
  ]
 },
