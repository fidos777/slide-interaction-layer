 "prose_styled_as_heading": {
  "cls": "SOURCE_DERIVED",
  "count": 6,
  "rows": [
   {
    "row_id": "T03B03-ROW-004",
    "text": "Mewujudkan pemandangan yang menarik secara visual serta mengurangkan kerataan tapak.",
    "module_page": 250,
    "style": "Heading3"
   },
   {
    "row_id": "T03B03-ROW-005",
    "text": "Berfungsi sebagai penghadang visual atau bunyi.",
    "module_page": 250,
    "style": "Heading3"
   },
   {
    "row_id": "T03B03-ROW-006",
    "text": "Mengawal dan mengarahkan aliran air permukaan.",
    "module_page": 250,
    "style": "Heading3"
   },
   {
    "row_id": "T03B03-ROW-018",
    "text": "Mengelakkan tanah daripada menjadi tepu air, yang boleh merosakkan akar tanaman dan menjadikan kawasan tidak boleh digun",
    "module_page": 251,
    "style": "Heading3"
   },
   {
    "row_id": "T03B03-ROW-034",
    "text": "Membentuk kawasan rata di lereng bukit, menstabilkan cerun, dan menetapkan sempadan aras.",
    "module_page": 252,
    "style": "Heading3"
   },
   {
    "row_id": "T03B03-ROW-058",
    "text": "Menguruskan aliran air larian permukaan dengan memperlahankannya, menggalakkan penyerapan air ke dalam tanah, dan menapi",
    "module_page": 254,
    "style": "Heading3"
   }
  ]
 },
