 "mandatory_propositions": {
  "cls": "SOURCE_DERIVED",
  "derivation": "OBLIGATION_MARKER",
  "count": 9,
  "propositions": [
   {
    "row_id": "T07B01-ROW-015",
    "module_page": 303,
    "markers": [
     "perlu"
    ],
    "text": "Ini adalah langkah pertama dan paling jelas dalam demobilisasi. Semua peralatan dan jentera berat yang digunakan sepanjang projek perlu dikeluarkan dari tapak. Melibatkan penyenaraian dan pemeriksaan semua peralatan yang dimiliki atau disewa. Peralatan yang disewa akan dikembalikan kepada pembekal, manakala peralatan syarikat akan dipindahkan ke depoh atau tapak projek seterusnya.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pengeluaran Peralatan dan Jentera"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-021",
    "module_page": 304,
    "markers": [
     "mesti",
     "perlu"
    ],
    "text": "Semua peralatan mesti berada dalam keadaan bersih dan berfungsi sebelum dikeluarkan. Jadual pengangkutan perlu diselaraskan untuk mengelakkan kelewatan. Peralatan sewa perlu diperiksa bersama pembekal untuk mengelakkan pertikaian kerosakan.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pengeluaran Peralatan dan Jentera"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-028",
    "module_page": 305,
    "markers": [
     "perlu"
    ],
    "text": "Kontraktor perlu mematuhi Peraturan Kualiti Alam Sekeliling (Buangan Terjadual) jika ada sisa berbahaya, dan peraturan pengurusan sisa pepejal perbandaran. Kontraktor perlu menyediakan tong sampah industri (skip bins) yang mencukupi dan menguruskan pengangkutan sisa oleh syarikat yang berlesen.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pembuangan Bahan Berlebihan dan Sisa Binaan"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-036",
    "module_page": 306,
    "markers": [
     "mesti",
     "perlu"
    ],
    "text": "Piawaian kebersihan mesti ditetapkan dalam kontrak. Tapak perlu bebas dari semua sisa pembinaan, kesan kotoran, dan debu.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pembersihan Tapak Akhir"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-038",
    "module_page": 306,
    "markers": [
     "perlu"
    ],
    "text": "Kemudahan yang didirikan untuk menyokong projek perlu dibongkar dan dikeluarkan ini termasuk pejabat tapak, stor bahan sementara, tandas mudah alih, pagar keselamatan sementara, dan papan tanda projek.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Penyingkiran Kemudahan Sementara"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-045",
    "module_page": 306,
    "markers": [
     "perlu"
    ],
    "text": "Kawasan di mana kemudahan sementara ini didirikan perlu dipulihkan (contohnya, menanam semula rumput jika tanah rosak).",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Penyingkiran Kemudahan Sementara"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-046",
    "module_page": 306,
    "markers": [
     "perlu"
    ],
    "text": "Pemulihan Tapak (Jika Diperlukan)",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pemulihan Tapak (Jika Diperlukan)"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-053",
    "module_page": 307,
    "markers": [
     "perlu"
    ],
    "text": "Kawasan yang dipulihkan perlu sepadan dengan landskap sekitarnya dan mematuhi piawaian pemulihan alam sekitar.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Pemulihan Tapak (Jika Diperlukan)"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
    "row_id": "T07B01-ROW-063",
    "module_page": 307,
    "markers": [
     "mesti",
     "perlu"
    ],
    "text": "Semua senarai semak demobilisasi mesti diisi dan ditandatangani. Dokumentasi yang lengkap dan tepat perlu disediakan.",
    "heading_path": [
     "DEMOBILISASI",
     "Proses Demoblisasi",
     "Spesifikasi"
    ],
    "cls": "SOURCE_DERIVED"
   }
  ]
 },
