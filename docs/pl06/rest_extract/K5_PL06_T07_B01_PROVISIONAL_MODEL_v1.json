    "module_page": 303,
    "markers": [
     "adalah"
    ],
    "text": "Memastikan semua bahaya telah dihapuskan dan tapak adalah selamat untuk pekerja dan orang awam.",
    "heading_path": [
     "DEMOBILISASI",
     "Tujuan Demobilisasi",
     "Keselamatan Tapak"
    ],
    "cls": "SOURCE_DERIVED"
   },
   {
